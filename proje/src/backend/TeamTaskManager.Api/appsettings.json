{
  "Jwt": {
    "Issuer": "TeamTaskManager.Api",
    "Audience": "TeamTaskManager.Clients",
    "Key": "replace-this-with-a-local-secret-key-2026",
    "ExpirationMinutes": 60
  },
  "FileStorage": {
    "RootPath": "uploads",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".docx", ".xlsx", ".txt" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TeamTaskManagerDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

